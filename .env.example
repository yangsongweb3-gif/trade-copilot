# 复制成 .env 再填写；.env 不会提交到 git

# 访问币安需要代理时填写，例如 http://127.0.0.1:7890；直连就留空
HTTPS_PROXY=

# 本机 NapCat（OneBot 11 HTTP 接口），提醒发到 QQ 私聊
NAPCAT_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=
# 接收提醒的 QQ 号（必须是机器人号的好友）
QQ_USER_ID=

# PushPlus：紧急提醒同时推到微信；不用就留空
PUSHPLUS_TOKEN=

# 每日日报图片：python -m copilot.report 生成的长图存到这里（不填就存 data/report/）
REPORT_DIR=
REPORT_NAME=BTC消息日报
# 个别好友换右上角二维码：REPORT_QR_<QQ号>=二维码图片路径|二维码下的名字
# REPORT_QR_123456=E:\path\to\qrcode.png|群名字

# 网页版（GitHub Pages）：配置了 SITE_REPO，每天出图后会把首页导出成静态网页推上去
SITE_REPO=
SITE_URL=
# 本地发布目录（独立 git 仓库），不填就用 data/report/site
SITE_DIR=
